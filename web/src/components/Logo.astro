---
/**
 * The mark: a lowercase "t" drawn as one line that ends in a node, the same
 * line-into-node grammar as the architecture diagrams. It draws itself once per
 * browser session, then stays still.
 */
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <path
    class="logo-stroke"
    pathLength="1"
    d="M6 9.25H16.5M10.75 3.75V15.5C10.75 18.6 12.4 20.25 15.25 20.25"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle class="logo-node" cx="18.6" cy="20.25" r="1.65" fill="#6fdcaa" />
</svg>
<script is:inline>
  try {
    if (!sessionStorage.getItem('ts-mark-drawn')) {
      sessionStorage.setItem('ts-mark-drawn', '1');
      document.currentScript.previousElementSibling.classList.add('is-drawing');
    }
  } catch (e) {}
</script>

<style>
  .logo-node {
    transform-box: fill-box;
    transform-origin: center;
  }
  .is-drawing .logo-stroke {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 720ms cubic-bezier(0.65, 0, 0.35, 1) 150ms forwards;
  }
  .is-drawing .logo-node {
    transform: scale(0);
    animation: pop 280ms cubic-bezier(0.22, 1, 0.36, 1) 820ms forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pop {
    to {
      transform: scale(1);
    }
  }
</style>
