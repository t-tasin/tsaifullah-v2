---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AnimatedName from '../components/AnimatedName';
import LivingAvatar from '../components/LivingAvatar';
import CopyEmail from '../components/CopyEmail';
import Experience from '../components/Experience';
import ProjectCard from '../components/ProjectCard.astro';
import { roles, education, leadership } from '../data/experience';
import { research } from '../data/research';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Tasin · KM Khalid Saifullah">
  <!-- Hero -->
  <section class="pt-14 sm:pt-20 pb-24 sm:pb-28 grid md:grid-cols-[1fr_260px] gap-10 items-center animate-fade-in-up">
    <div class="min-w-0">
      <p class="t-label mb-5">KM Khalid Saifullah · Wooster, OH</p>
      <AnimatedName client:load />

      <p class="t-lead text-foreground mt-7 max-w-[34ch] text-balance">
        I find the problem by talking to the people living with it, then build the fix and run it in production.
      </p>
      <p class="mt-5 text-muted leading-relaxed max-w-[58ch]">
        I build the things I've watched people quietly route around. Most recently that meant AtlasDesk, an IT service platform I built solo at the college where I was also the one answering the tickets. It replaced a $20K/year vendor tool for 4,000+ people, and I now lead the four college engineers who maintain it.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <CopyEmail client:load />
        <a href="https://www.linkedin.com/in/k-tasin/" target="_blank" rel="noopener noreferrer" class="pressable inline-flex items-center h-10 px-4 rounded-full border border-border text-sm text-foreground hover:border-white/20 hover:bg-white/[0.04] transition-colors">LinkedIn</a>
        <a href="https://github.com/t-tasin" target="_blank" rel="noopener noreferrer" class="pressable inline-flex items-center h-10 px-4 rounded-full border border-border text-sm text-foreground hover:border-white/20 hover:bg-white/[0.04] transition-colors">GitHub</a>
      </div>
      <p class="mt-6 text-sm text-faint">Open to product and engineering roles.</p>
    </div>

    <div class="hidden md:block opacity-90" aria-hidden="true">
      <LivingAvatar client:media="(min-width: 768px)" />
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="mb-28 animate-fade-in-up" style="animation-delay: 80ms;">
    <p class="t-label mb-3">Selected work</p>
    <h2 class="t-heading text-foreground mb-8 max-w-[40ch]">Systems I designed, shipped, and now run.</h2>
    <div class="grid grid-cols-1 gap-5">
      {projects.map((entry) => <ProjectCard entry={entry} />)}
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="mb-28">
    <p class="t-label mb-3">Experience</p>
    <h2 class="t-heading text-foreground mb-6 max-w-[44ch]">Read it from the product side, the engineering side, or both.</h2>
    <Experience client:visible roles={roles} />
  </section>

  <!-- Research -->
  <section id="research" class="mb-28">
    <p class="t-label mb-3">Research</p>
    <h2 class="t-heading text-foreground mb-8">Papers</h2>
    <div class="flex flex-col gap-4">
      {research.map((paper) => (
        <article class="rounded-2xl border border-border bg-surface/40 p-6 sm:p-7">
          <div class="flex justify-between items-baseline gap-4 mb-2">
            <h3 class="text-lg font-semibold tracking-[-0.01em] text-foreground leading-snug text-balance">
              {paper.title}
            </h3>
            <span class="font-mono text-xs text-faint shrink-0 tabular-nums">{paper.year}</span>
          </div>
          <p class="text-sm text-muted mb-4">
            <span class="text-foreground">{paper.status}</span> · {paper.venue} · {paper.authors.join(', ')}
          </p>

          <details class="group">
            <summary class="list-none cursor-pointer text-sm text-muted leading-relaxed [&::-webkit-details-marker]:hidden">
              <span class="line-clamp-2 group-open:hidden">{paper.abstract}</span>
              <span class="inline-flex items-center gap-1 mt-2 text-accent">
                <span class="group-open:hidden">Read abstract</span>
                <span class="hidden group-open:inline">Hide abstract</span>
              </span>
            </summary>
            <p class="text-sm text-muted leading-relaxed mt-3 max-w-[72ch]">{paper.abstract}</p>
          </details>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            {paper.keywords.map((kw) => <span class="chip">{kw}</span>)}
            {paper.links?.paper && (
              <a href={paper.links.paper} target="_blank" rel="noopener noreferrer" class="pressable ml-auto text-sm text-accent hover:text-foreground transition-colors">
                Read paper ↗
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Education & leadership -->
  <section class="mb-8 grid grid-cols-1 md:grid-cols-2 gap-12">
    <div>
      <p class="t-label mb-5">Education</p>
      <p class="text-foreground font-semibold tracking-[-0.01em]">{education.school}</p>
      <p class="text-muted mt-1">{education.degree}</p>
      <p class="text-muted">{education.honors}</p>
      <p class="font-mono text-xs text-faint mt-2 tabular-nums">{education.year}</p>
    </div>
    <div>
      <p class="t-label mb-5">Leadership</p>
      <ul class="flex flex-col gap-4">
        {leadership.map((item) => (
          <li>
            <p class="text-foreground font-medium">{item.name}</p>
            <p class="text-muted text-sm mt-0.5">{item.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
